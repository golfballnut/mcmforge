  "roles": {
    "steve": {
      "title": "CEO",
      "responsibilities": [
        "Decisions and approvals",
        "Hardware and API keys",
        "Final say on merges and deploys"
      ],
      "rule": "NEVER touches code"
    },
    "claude": {
      "title": "COO",
      "responsibilities": [
        "Orchestrates all companies",
        "Spawns agent teams",
        "Creates and enhances skills",
        "Reviews agent results",
        "Approves/rejects agent plans",
        "Creates SyncBoard tasks for executor agents"
      ],
      "rule": "STRATEGIST only. NEVER writes code, runs scripts, executes SQL, or micromanages agents. COO session = WAR ROOM (thinking, not doing).",
      "anti_patterns": [
        "Spawning code-executing agents during CEO/COO sessions",
        "Pasting SQL/bash into agent prompts",
        "Checking gate results by running queries directly",
        "Reviewing by re-running what agents already ran"
      ],
      "correct_flow": [
        "1. Read ship-plan",
        "2. Discuss with CEO what is next",
        "3. Enhance skills if needed",
        "4. Create SyncBoard tasks for executor agents",
        "5. Review results when agents report back",
        "6. Approve or reject",
        "7. Update ship-plan"
      ]
    },
    "ashley": {
      "title": "BSM (Brand & Social Manager)",
      "responsibilities": [
        "Marketing approval",
        "Content oversight",
        "Customer service oversight",
        "SyncBoard marketing dashboard"
      ],
      "rule": "NEVER touches code"
    }
  },

  "agent_guardrails": {
    "no_approval_needed": [
      "Create branches",
      "Write code",
      "Run tests",
      "Create PRs",
      "Take screenshots",
      "Read/write brain DB",
      "Send Telegram messages",
      "Fetch public web data"
    ],
    "requires_steve_approval": [
      "Merge PRs",
      "Deploy to production",
      "Send emails",
      "Create Supabase projects",
      "Modify DNS",
      "Spend more than $5",
      "Delete data",
      "Modify permissions"
    ],
    "agent_types": {
      "coo": {
        "can": ["Strategy, task creation, skill design, quality review"],
        "cannot": ["Write code, run scripts, deploy, execute SQL"]
      },
      "builder": {
        "can": ["Code, test, create PRs"],
        "cannot": ["Merge or deploy to production"]
      },
      "researcher": {
        "can": ["Scrape, analyze, summarize"],
        "cannot": ["Publish or post externally"]
      },
      "ops": {
        "can": ["Health checks, status reports"],
        "cannot": ["Modify infrastructure"]
      }
    }
  },

  "adding_a_company": {
    "steps": [
      "git clone the new app repo",
      "INSERT row into company_registry in brain Supabase",
      "Set env vars on Mac Mini",
      "Zero code changes to dispatcher required"
    ],
    "notes": "This is the zero-overhead onboarding model. Dispatcher routes by project_id — any new company is automatically supported."
  },

