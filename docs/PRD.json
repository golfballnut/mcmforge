  "quality_gates": {
    "git_workflow": {
      "master_protection": "Direct pushes rejected by GitHub",
      "required_flow": "Feature branch → PR → Steve approval → Claude merges",
      "branch_naming": {
        "agent_tasks": "agent/{task-slug}",
        "feature_work": "feature/{name}",
        "ops_work": "ops/{name}"
      }
    },
    "merge_rules": [
      "ALL CI checks must pass before merge (no exceptions)",
      "Steve must see preview URL and confirm feature works",
      "Vercel preview must deploy successfully",
      "COO reviews code quality but Steve has final say"
    ]
  },

  "context_budget": {
    "rule": "Every Task() call MUST include model= and max_turns=",
    "agent_types": {
      "scouts": { "model": "claude-haiku-4-5-20251001", "max_turns": 5, "background": true },
      "code_editing": { "model": "claude-sonnet-4-6", "max_turns": 10, "background": false },
      "build_test": { "model": "claude-sonnet-4-6", "max_turns": 10, "background": false },
      "visual_grading": { "model": "claude-haiku-4-5-20251001", "max_turns": 3, "background": true }
    },
    "critical": "Scouts that read Supabase/large files MUST use run_in_background: true. Foreground scouts inject 40-60k tokens into parent context. Orchestrators: max 4 spawns per session segment — write brain file before hitting limit."
  },

