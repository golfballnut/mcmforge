{
  "platform_name": "MCM Forge",
  "tagline": "Build + launch a fully autonomous AI-run business every day.",
  "description": "MCM Forge is an AI agent factory and parent company (MCM = McMIllian legacy). It orchestrates autonomous AI-run businesses at scale — COO (Claude) runs the companies, gives Steve tasks, not the other way around.",
  "type": "platform",
  "status": "operational",
  "founded": "2026-02-23",

  "identity": {
    "parent_company": "MCM Forge",
    "abbreviation": "MCM (McMIllian legacy)",
    "domain": "mcmforge.com",
    "github_repo": "golfballnut/mcmforge",
    "dashboard_url": "https://mcmforge.com",
    "legal": {
      "status": "pending_LLC",
      "trademark": "pending",
      "attorney": "Richard & John"
    }
  },

  "infrastructure": {
    "dashboard": {
      "framework": "Next.js 16",
      "hosting": "Vercel",
      "repo": "golfballnut/mcmforge",
      "status": "live",
      "pages": [
        "Dashboard",
        "Companies",
        "Tasks",
        "Approvals",
        "Agents",
        "Metrics",
        "Research",
        "Briefs"
      ],
      "zero_404s": true
    },
    "brain_supabase": {
      "project_id": "ncwxeeqvujgyiggkviqq",
      "region": "us-east-1",
      "purpose": "Central orchestration — NOT business data",
      "extensions": ["pgvector"],
      "capabilities": ["semantic search", "agent memory", "task routing"],
      "tables": [
        "task_queue",
        "agent_memory",
        "agent_learnings",
        "skill_metrics",
        "company_registry",
        "agent_roster",
        "approval_queue",
        "communication_log",
        "coo_decisions",
        "daily_briefs"
      ]
    },
    "dispatcher": {
      "file": "dispatcher/dispatcher.ts",
      "status": "built (PR #4 ready to merge)",
      "behavior": "Polls task_queue, reads project_id, routes to correct repo directory on Mac Mini, runs git pull + claude --print, reports results back to brain DB",
      "host": "Mac Mini (always-on executor)",
      "polling_interval": "5 minutes"
    },
    "mac_mini": {
      "role": "Always-on executor node",
      "pm2": true,
      "env_loading": "dotenv internally (NOT --update-env for .env files)",
      "setup_status": "pending (Session 9 task)"
    },
    "communication": {
      "channels": [
        {
          "name": "War Room",
          "participants": "Steve + COO",
          "purpose": "Strategy, task creation, skill design, quality review"
        },
        {
          "name": "Automated Pipeline",
          "participants": "Brain DB + Mac Mini + agents",
          "purpose": "Execution — task arrives, agent runs, reports back"
        },
        {
          "name": "Telegram",
          "bot": "@dirtSync_agent_bot",
          "capability": "Text-to-ship in 155s"
        }
      ]
    }
  },

  "auth": {
    "admin_account": "steve@mcmforge.com",
    "agent_account": {
      "email": "agent@mcmforge.com",
      "status": "pending creation (Session 9)",
      "rls_policy": {
        "allowed": [
          "SELECT task_queue",
          "SELECT company_registry",
          "UPDATE task_queue",
          "INSERT approval_queue",
          "INSERT communication_log"
        ],
        "blocked": [
          "DELETE any table",
          "touch auth",
          "modify company_registry",
          "use service_role key"
        ]
      }
    }
  },

  "companies": [
    {
      "id": "C-001",
      "name": "DirtSync",
      "status": "operational",
      "domain": "dirtsync.app",
      "supabase_project_id": "lldipxvwocpqncixlnxj",
      "repo": "golfballnut/DirtSync",
      "tagline": "Turn-by-Turn Trail Navigation — Built by Riders, for Riders.",
      "registered_date": "2026-02-23",
      "description": "iOS + Web trail navigation app for off-road riders (ATV, UTV, dirt bike, 4x4). Company #1 under MCM Forge."
