<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mcmforge.standup-cron</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/dirtsyncmini/MCMForge/forge-orchestrator/scripts/run-standup-cron.sh</string>
  </array>

  <!-- Daily at 07:00 ET (UTC-4 summer / UTC-5 winter).
       launchd fires at local system time. Mini must be set to America/New_York. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/dirtsyncmini/MCMForge/forge-orchestrator</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/dirtsyncmini/Library/Logs/mcmforge-standup.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/dirtsyncmini/Library/Logs/mcmforge-standup.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
